from PPlay.window import *
from PPlay.mouse import *
from PPlay.keyboard import *
import sys

# 1. Inicialização da Janela e Inputs do PPlay
janela = Window(800, 600)
janela.set_title("Space Invaders")

mouse = Window.get_mouse()
teclado = Window.get_keyboard()

estado_atual = "MENU"

# ================= FUNÇÕES AUXILIARES =================
# O PPlay puro não tem "botões de texto" nativos. 
# Criamos essas funções para saber se o mouse está em cima das coordenadas de um texto.

def area_mouse_sobre(x, y, largura, altura):
    """Retorna True se o mouse estiver dentro do retângulo especificado"""
    pos_x, pos_y = mouse.get_position()
    return (x <= pos_x <= x + largura) and (y <= pos_y <= y + altura)

def cor_botao(x, y, largura, altura):
    """Muda a cor do botão para amarelo (efeito Hover) se o mouse passar por cima"""
    if area_mouse_sobre(x, y, largura, altura):
        return (255, 255, 0) # Amarelo
    return (200, 200, 200)   # Cinza Claro

# ================= LOOP PRINCIPAL =================
while True:
    janela.set_background_color((0, 0, 0)) # Fundo preto
    
    # ------------------ ESTADO: MENU ------------------
    if estado_atual == "MENU":
        # Título
        janela.draw_text("SPACE INVADERS", 170, 80, size=60, color=(255, 255, 255), font_name="Arial", bold=True)
        
        # Botão JOGAR
        cor = cor_botao(330, 220, 150, 40)
        janela.draw_text("JOGAR", 330, 220, size=40, color=cor, font_name="Arial", bold=True)
        if area_mouse_sobre(330, 220, 150, 40) and mouse.is_button_pressed(1):
            estado_atual = "JOGAR"
            janela.delay(200) # Pequeno atraso para não registrar "clique duplo" sem querer
            
        # Botão DIFICULDADE
        cor = cor_botao(280, 300, 260, 40)
        janela.draw_text("DIFICULDADE", 280, 300, size=40, color=cor, font_name="Arial", bold=True)
        if area_mouse_sobre(280, 300, 260, 40) and mouse.is_button_pressed(1):
            estado_atual = "DIFICULDADE"
            janela.delay(200)
            
        # Botão RANKING
        cor = cor_botao(310, 380, 180, 40)
        janela.draw_text("RANKING", 310, 380, size=40, color=cor, font_name="Arial", bold=True)
        if area_mouse_sobre(310, 380, 180, 40) and mouse.is_button_pressed(1):
            pass # Não faz nada por enquanto, conforme pedido
            
        # Botão SAIR
        cor = cor_botao(350, 460, 100, 40)
        janela.draw_text("SAIR", 350, 460, size=40, color=cor, font_name="Arial", bold=True)
        if area_mouse_sobre(350, 460, 100, 40) and mouse.is_button_pressed(1):
            janela.close()
            sys.exit()

    # ------------------ ESTADO: JOGAR ------------------
    elif estado_atual == "JOGAR":
        janela.draw_text("GAME LOOP VAZIO", 180, 250, size=50, color=(255, 255, 255), bold=True)
        janela.draw_text("Pressione ESC para voltar ao Menu", 200, 320, size=30, color=(150, 150, 150))
        
        # Volta ao menu com ESC
        if teclado.key_pressed("ESC"):
            estado_atual = "MENU"
            janela.delay(200)

    # --------------- ESTADO: DIFICULDADE ---------------
    elif estado_atual == "DIFICULDADE":
        janela.draw_text("DIFICULDADE", 240, 80, size=50, color=(255, 255, 255), bold=True)
        
        # Fácil
        cor = cor_botao(340, 220, 120, 40)
        janela.draw_text("FÁCIL", 340, 220, size=40, color=cor, bold=True)
        if area_mouse_sobre(340, 220, 120, 40) and mouse.is_button_pressed(1):
            # Ação de colocar no fácil seria aqui
            estado_atual = "MENU"
            janela.delay(200)
            
        # Médio
        cor = cor_botao(330, 300, 140, 40)
        janela.draw_text("MÉDIO", 330, 300, size=40, color=cor, bold=True)
        if area_mouse_sobre(330, 300, 140, 40) and mouse.is_button_pressed(1):
            estado_atual = "MENU"
            janela.delay(200)
            
        # Difícil
        cor = cor_botao(320, 380, 160, 40)
        janela.draw_text("DIFÍCIL", 320, 380, size=40, color=cor, bold=True)
        if area_mouse_sobre(320, 380, 160, 40) and mouse.is_button_pressed(1):
            estado_atual = "MENU"
            janela.delay(200)
            
        # Voltar
        cor = cor_botao(330, 480, 150, 40)
        janela.draw_text("VOLTAR", 330, 480, size=40, color=cor, bold=True)
        if area_mouse_sobre(330, 480, 150, 40) and mouse.is_button_pressed(1):
            estado_atual = "MENU"
            janela.delay(200)

    # Desenha tudo que foi configurado neste frame
    janela.update()
