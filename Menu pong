from PPlay.window import *
from PPlay.sprite import *
from PPlay.mouse import *
from PPlay.keyboard import *
import sys

# 1. Configuração da Janela
janela = Window(800, 600)
janela.set_title("Space Invaders")

mouse = Window.get_mouse()
teclado = Window.get_keyboard()

# Variáveis de estado e configuração
estado_atual = "MENU"
dificuldade_atual = "FÁCIL"

# ================= FUNÇÃO AUXILIAR PARA SPRITES =================
def criar_botao_centralizado(caminho_imagem, y):
    """Carrega o PNG da pasta assets e centraliza no eixo X automaticamente."""
    botao = Sprite(caminho_imagem)
    botao.x = (janela.width / 2) - (botao.width / 2)
    botao.y = y
    return botao

# ================= CARREGAMENTO DE IMAGENS (PNGs) =================
# Lembre-se de criar a pasta "assets" e colocar os PNGs lá dentro!

# Sprites do Menu Principal
titulo_principal = criar_botao_centralizado("assets/titulo.png", 80)
btn_jogar        = criar_botao_centralizado("assets/jogar.png", 220)
btn_dificuldade  = criar_botao_centralizado("assets/dificuldade.png", 300)
btn_ranking      = criar_botao_centralizado("assets/ranking.png", 380)
btn_sair         = criar_botao_centralizado("assets/sair.png", 460)

# Sprites da Tela de Dificuldade
titulo_dif  = criar_botao_centralizado("assets/titulo_dificuldade.png", 80)
btn_facil   = criar_botao_centralizado("assets/facil.png", 220)
btn_medio   = criar_botao_centralizado("assets/medio.png", 300)
btn_dificil = criar_botao_centralizado("assets/dificil.png", 380)
btn_voltar  = criar_botao_centralizado("assets/voltar.png", 480)

# ================= LOOP PRINCIPAL =================
while True:
    janela.set_background_color((0, 0, 0))
    
    # ------------------ ESTADO: MENU ------------------
    if estado_atual == "MENU":
        titulo_principal.draw()
        btn_jogar.draw()
        btn_dificuldade.draw()
        btn_ranking.draw()
        btn_sair.draw()
        
        # Checagem de cliques usando is_over_object
        if mouse.is_over_object(btn_jogar) and mouse.is_button_pressed(1):
            estado_atual = "JOGAR"
            janela.delay(200)
            
        elif mouse.is_over_object(btn_dificuldade) and mouse.is_button_pressed(1):
            estado_atual = "DIFICULDADE"
            janela.delay(200)
            
        elif mouse.is_over_object(btn_ranking) and mouse.is_button_pressed(1):
            pass # Ranking em construção
            
        elif mouse.is_over_object(btn_sair) and mouse.is_button_pressed(1):
            janela.close()
            sys.exit()

    # ------------------ ESTADO: JOGAR ------------------
    elif estado_atual == "JOGAR":
        # Textos informativos pequenos no canto superior esquerdo
        janela.draw_text(f"Dificuldade: {dificuldade_atual}", 10, 10, size=20, color=(255, 255, 255), bold=True)
        janela.draw_text("ESC para sair", 10, 35, size=18, color=(200, 200, 200))
        
        # Volta ao menu
        if teclado.key_pressed("ESC"):
            estado_atual = "MENU"
            janela.delay(200)

    # --------------- ESTADO: DIFICULDADE ---------------
    elif estado_atual == "DIFICULDADE":
        titulo_dif.draw()
        btn_facil.draw()
        btn_medio.draw()
        btn_dificil.draw()
        btn_voltar.draw()
        
        # Ao clicar, atualiza a variável e vai DIRETO para o jogo
        if mouse.is_over_object(btn_facil) and mouse.is_button_pressed(1):
            dificuldade_atual = "FÁCIL"
            estado_atual = "JOGAR"
            janela.delay(200)
            
        elif mouse.is_over_object(btn_medio) and mouse.is_button_pressed(1):
            dificuldade_atual = "MÉDIO"
            estado_atual = "JOGAR"
            janela.delay(200)
            
        elif mouse.is_over_object(btn_dificil) and mouse.is_button_pressed(1):
            dificuldade_atual = "DIFÍCIL"
            estado_atual = "JOGAR"
            janela.delay(200)
            
        elif mouse.is_over_object(btn_voltar) and mouse.is_button_pressed(1):
            estado_atual = "MENU"
            janela.delay(200)

    janela.update()
