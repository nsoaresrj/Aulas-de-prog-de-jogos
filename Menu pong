from PPlay.window import *
from PPlay.sprite import * # <-- Agora importamos o Sprite para lidar com imagens!
from PPlay.mouse import *
from PPlay.keyboard import *
import sys

# Começamos criando a janela padrão.
janela = Window(800, 600) 
janela.set_title("Space Invaders")

mouse = Window.get_mouse()
teclado = Window.get_keyboard()

estado_atual = "MENU"
dificuldade_atual = "FÁCIL"

# ================= CARREGAMENTO DE IMAGENS (SPRITES) =================

# Em vez de repetir a fórmula matemática toda hora, criei essa função auxiliar.
# Ela carrega a imagem do botão e já calcula o "X" para ele ficar perfeitamente no meio.
def criar_botao_centralizado(nome_imagem, y):
    # Carrega a imagem PNG
    botao = Sprite(nome_imagem)
    # A mágica do PPlay: o Sprite já sabe a própria largura (botao.width)!
    # Então a fórmula de centralizar fica super exata e fácil.
    botao.x = (janela.width / 2) - (botao.width / 2)
    botao.y = y
    return botao

# Agora eu crio todos os botões UMA VEZ SÓ aqui no início.
# Eles ficam guardados na memória, prontos para serem desenhados no loop.

# Imagens do Menu Principal
titulo_principal = criar_botao_centralizado("titulo.png", 80) # Uma imagem bem bonita pro título!
btn_jogar        = criar_botao_centralizado("jogar.png", 220)
btn_dificuldade  = criar_botao_centralizado("dificuldade.png", 300)
btn_ranking      = criar_botao_centralizado("ranking.png", 380)
btn_sair         = criar_botao_centralizado("sair.png", 460)

# Imagens da tela de Dificuldade
titulo_dif  = criar_botao_centralizado("titulo_dificuldade.png", 80)
btn_facil   = criar_botao_centralizado("facil.png", 220)
btn_medio   = criar_botao_centralizado("medio.png", 300)
btn_dificil = criar_botao_centralizado("dificil.png", 380)
btn_voltar  = criar_botao_centralizado("voltar.png", 480)


# ================= LOOP PRINCIPAL =================
# Bora pro jogo!
while True:
    janela.set_background_color((0, 0, 0)) # Limpa o frame anterior pintando de preto
    
    # ------------------ ESTADO: MENU ------------------
    if estado_atual == "MENU":
        
        # 1. DESENHAR TUDO: 
        # Com sprites, eu só chamo o método .draw() e eles aparecem na tela.
        titulo_principal.draw()
        btn_jogar.draw()
        btn_dificuldade.draw()
        btn_ranking.draw()
        btn_sair.draw()
        
        # 2. VERIFICAR CLIQUES:
        # Olha como ficou lindo! Não preciso mais de matemática de colisão.
        # A função mouse.is_over_object() do PPlay checa sozinha se o ponteiro tá em cima da imagem!
        
        if mouse.is_over_object(btn_jogar) and mouse.is_button_pressed(1):
            estado_atual = "JOGAR"
            janela.delay(200) # O velho delay pra não dar "clique duplo" sem querer
            
        elif mouse.is_over_object(btn_dificuldade) and mouse.is_button_pressed(1):
            estado_atual = "DIFICULDADE"
            janela.delay(200)
            
        elif mouse.is_over_object(btn_ranking) and mouse.is_button_pressed(1):
            pass # Ranking ainda em construção
            
        elif mouse.is_over_object(btn_sair) and mouse.is_button_pressed(1):
            janela.close()
            sys.exit()

    # ------------------ ESTADO: JOGAR ------------------
    elif estado_atual == "JOGAR":
        # Aqui faz sentido continuar usando texto simples (draw_text), 
        # porque são só informações da interface (HUD), não botões interativos.
        janela.draw_text(f"Dificuldade: {dificuldade_atual}", 10, 10, size=20, color=(255, 255, 255), bold=True)
        janela.draw_text("ESC para sair", 10, 35, size=18, color=(200, 200, 200))
        
        if teclado.key_pressed("ESC"):
            estado_atual = "MENU"
            janela.delay(200)

    # --------------- ESTADO: DIFICULDADE ---------------
    elif estado_atual == "DIFICULDADE":
        
        # 1. DESENHAR TUDO:
        titulo_dif.draw()
        btn_facil.draw()
        btn_medio.draw()
        btn_dificil.draw()
        btn_voltar.draw()
        
        # 2. VERIFICAR CLIQUES:
        # Mesma lógica. Clicou na imagem do nível, altera a variável e joga pro game loop.
        
        if mouse.is_over_object(btn_facil) and mouse.is_button_pressed(1):
            dificuldade_atual = "FÁCIL"
            estado_atual = "JOGAR"
            janela.delay(200)
            
        elif mouse.is_over_object(btn_medio) and mouse.is_button_pressed(1):
            dificuldade_atual = "MÉDIO"
            estado_atual = "JOGAR"
            janela.delay(200)
            
        elif mouse.is_over_object(btn_dificil) and mouse.is_button_pressed(1):
            dificuldade_atual = "DIFÍCIL"
            estado_atual = "JOGAR"
            janela.delay(200)
            
        elif mouse.is_over_object(btn_voltar) and mouse.is_button_pressed(1):
            estado_atual = "MENU"
            janela.delay(200)

    # Cospe os desenhos todos pra tela de uma vez!
    janela.update()
