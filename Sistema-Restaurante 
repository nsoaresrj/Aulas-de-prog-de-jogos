            lista.insert(tk.END, f" ID: {i[0]} | [{i[3]}] {i[1]} - R$ {i[2]:.2f}")

    def ao_selecionar_item(event):
        sel = lista.curselection()
        if not sel: return
        texto_item = lista.get(sel[0])
        
        id_extraido = texto_item.split("|")[0].replace("ID:", "").strip()
        id_item_selecionado[0] = id_extraido
        
        cursor.execute("SELECT nome, preco, categoria FROM cardapio WHERE id=?", (id_extraido,))
        resultado = cursor.fetchone()
        if resultado:
            entry_nome.delete(0, tk.END)
            entry_nome.insert(0, resultado[0])
            
            entry_preco.delete(0, tk.END)
            entry_preco.insert(0, f"{resultado[1]:.2f}".replace(".", ","))
            
            entry_cat.delete(0, tk.END)
            entry_cat.insert(0, resultado[2])

    lista.bind("<<ListboxSelect>>", ao_selecionar_item)

    def adicionar():
        try:
            nome = entry_nome.get().strip()
            preco_str = entry_preco.get().strip().replace(",", ".")
