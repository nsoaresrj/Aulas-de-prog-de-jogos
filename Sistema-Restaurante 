def carregar_cardapio():
    cursor.execute("SELECT id, nome, preco, categoria FROM cardapio ORDER BY nome")
    return cursor.fetchall()

def on_categoria_selecionada(event):
    global categoria_selecionada
    sel = lista_categorias.curselection()
    if not sel: return
    
    item = lista_categorias.get(sel[0])
    if item == "✨ Todos os Itens":
        categoria_selecionada = "Todos"
    else:
        categoria_selecionada = item.replace("📁 ", "")
        
    filtrar_cardapio()

def atualizar_lista_categorias():
    lista_categorias.delete(0, tk.END)
    lista_categorias.insert(tk.END, "✨ Todos os Itens")
    
    cursor.execute("SELECT DISTINCT categoria FROM cardapio WHERE categoria IS NOT NULL AND categoria != '' ORDER BY categoria")
    categorias_banco = [c[0] for c in cursor.fetchall()]
    
    for cat in categorias_banco:
        lista_categorias.insert(tk.END, f"📁 {cat}")
    
    lista_categorias.selection_set(0)

def filtrar_cardapio(event=None):
    termo_busca = entry_busca_cardapio.get().lower().strip()
    lista_cardapio.delete(0, tk.END)
    mapeamento_cardapio.clear()
    
    produtos_do_banco = carregar_cardapio()
    idx_visivel = 0
    
    for item in produtos_do_banco:
        id_prod, nome_prod, preco_prod, cat_prod = item
        
        match_categoria = (categoria_selecionada == "Todos") or (cat_prod.lower() == categoria_selecionada.lower())
        match_busca = termo_busca in nome_prod.lower() or "🔍" in termo_busca
        
        if "🔍" in entry_busca_cardapio.get():
            match_busca = True

        if match_categoria and match_busca:
            lista_cardapio.insert(tk.END, f" {nome_prod}  •  R$ {preco_prod:.2f}")
            mapeamento_cardapio[idx_visivel] = {"id": id_prod, "nome": nome_prod, "preco": preco_prod}
            idx_visivel += 1

def atualizar_cardapio():
    entry_busca_cardapio.delete(0, tk.END)
    atualizar_lista_categorias()
    filtrar_cardapio()

