def iniciar_expediente():
    global expediente_ativo, pasta_pedidos_atual, pasta_comandas_atual
    if expediente_ativo:
        messagebox.showwarning("Aviso", f"O expediente do dia {expediente_ativo} já está ativo!")
        return
    
    data_abertura = datetime.now().strftime("%d-%m-%Y")
    expediente_ativo = data_abertura
    
    pasta_dia = os.path.join(pasta_principal, f"Expediente_{data_abertura}")
    pasta_pedidos_atual = os.path.join(pasta_dia, "pedidos_txt")
    pasta_comandas_atual = os.path.join(pasta_dia, "comandas")
    
    os.makedirs(pasta_pedidos_atual, exist_ok=True)
    os.makedirs(pasta_comandas_atual, exist_ok=True)
    
    lbl_expediente.config(text=f"● EXPEDIENTE ATIVO ({data_abertura})", fg="#198754")
    carregar_pedidos()
    messagebox.showinfo("Expediente Iniciado", f"Turno iniciado com sucesso para o dia: {data_abertura}")

def enviar_relatorio_fechamento_caixa():
    global expediente_ativo, pasta_pedidos_atual, pasta_comandas_atual
    if not expediente_ativo:
        messagebox.showwarning("Aviso", "Não há nenhum expediente ativo para encerrar!")
        return
    
    cursor.execute("SELECT total, pagamento, tipo FROM pedidos WHERE expediente = ?", (expediente_ativo,))
    pedidos_dia = cursor.fetchall()
    
    if not pedidos_dia:
        messagebox.showinfo("Fechamento", f"Expediente {expediente_ativo} encerrado sem movimentações.")
        expediente_ativo = None
        lbl_expediente.config(text="● EXPEDIENTE FECHADO", fg="#dc3545")
        carregar_pedidos()
        return
    
    total_geral = 0.0
    qtd_total = len(pedidos_dia)
    valores_por_pagamento = {}
    qtd_por_pagamento = {}
    qtd_por_tipo = {"Mesa": 0, "Viagem": 0, "Balcão": 0}
    
    for total, pagamento, tipo in pedidos_dia:
        total_geral += total
        valores_por_pagamento[pagamento] = valores_por_pagamento.get(pagamento, 0.0) + total
        qtd_por_pagamento[pagamento] = qtd_por_pagamento.get(pagamento, 0) + 1
        
        if tipo.startswith("Mesa"): qtd_por_tipo["Mesa"] += 1
        elif tipo == "Viagem": qtd_por_tipo["Viagem"] += 1
        elif tipo == "Balcão": qtd_por_tipo["Balcão"] += 1
        
    texto_relatorio = f"=== FECHAMENTO DE CAIXA INDIVIDUAL ===\n"
    texto_relatorio += f"Movimento: {expediente_ativo}\n"
    texto_relatorio += f"Fechamento: {datetime.now().strftime('%d-%m-%Y %H:%M:%S')}\n"
    texto_relatorio += f"----------------------------------------\n"
    texto_relatorio += f"Qtd. Total de Pedidos: {qtd_total}\n"
    texto_relatorio += f"Faturamento Bruto: R$ {total_geral:.2f}\n"
    texto_relatorio += f"----------------------------------------\n"
    texto_relatorio += f"RESUMO DE ATENDIMENTOS:\n"
    texto_relatorio += f"• Mesa: {qtd_por_tipo['Mesa']} pedido(s)\n"
    texto_relatorio += f"• Viagem: {qtd_por_tipo['Viagem']} pedido(s)\n"
    texto_relatorio += f"• Balcão: {qtd_por_tipo['Balcão']} pedido(s)\n"
    texto_relatorio += f"----------------------------------------\n"
    texto_relatorio += f"FALHAS E RECEBIMENTOS:\n\n"
    
    for forma in valores_por_pagamento.keys():
        texto_relatorio += f"• {forma}:\n"
        texto_relatorio += f"  Quantidade: {qtd_por_pagamento[forma]} pedido(s)\n"
        texto_relatorio += f"  Total: R$ {valores_por_pagamento[forma]:.2f}\n\n"
        
    pasta_dia = os.path.dirname(pasta_pedidos_atual)
    caminho_fechamento = os.path.join(pasta_dia, "resumo_fechamento_caixa.txt")
    with open(caminho_fechamento, "w", encoding="utf-8") as f:
        f.write(texto_relatorio)
        
    messagebox.showinfo("Relatório de Fechamento de Caixa", texto_relatorio)
    
    expediente_ativo = None
    pasta_pedidos_atual = None
    pasta_comandas_atual = None
    lbl_expediente.config(text="● EXPEDIENTE FECHADO", fg="#dc3545")
    carregar_pedidos()

