    entry_cat.pack(fill="x", pady=2)

    tk.Button(janela_edit, text="➕ Adicionar Novo Item", command=adicionar, bg="#198754", fg="white", font=("Arial", 10, "bold"), height=2, bd=0).pack(pady=4, fill="x", padx=15)
    tk.Button(janela_edit, text="💾 Salvar Alterações do Item Selecionado", command=salvar_edicao, bg="#0d6efd", fg="white", font=("Arial", 10, "bold"), height=2, bd=0).pack(pady=4, fill="x", padx=15)
