            cat = entry_cat.get().strip() or "Geral"
            
            if not nome or preco <= 0: raise ValueError
            
            cursor.execute("INSERT INTO cardapio (nome, preco, categoria) VALUES (?, ?, ?)", (nome, preco, cat))
            conn.commit()
            carregar()
            atualizar_cardapio()
            
            entry_nome.delete(0, tk.END)
            entry_preco.delete(0, tk.END)
            entry_cat.delete(0, tk.END)
            id_item_selecionado[0] = ""
        except ValueError:
            messagebox.showerror("Erro", "Insira um nome válido e preço maior que zero.")
        except sqlite3.IntegrityError:
            messagebox.showerror("Erro", "Este produto já está cadastrado!")

    def salvar_edicao():
        id_atual = id_item_selecionado[0]
        if not id_atual:
            messagebox.showwarning("Aviso", "Selecione um item da lista acima primeiro para editar!")
            return
            
        try:
            nome = entry_nome.get().strip()
            preco_str = entry_preco.get().strip().replace(",", ".")
            preco = float(preco_str)
            cat = entry_cat.get().strip() or "Geral"
            
            if not nome or preco <= 0: raise ValueError
            
            cursor.execute("UPDATE cardapio SET nome=?, preco=?, categoria=? WHERE id=?", (nome, preco, cat, id_atual))
            conn.commit()
            
            messagebox.showinfo("Sucesso", "Item atualizado com sucesso!")
            carregar()
            atualizar_cardapio()
            
            entry_nome.delete(0, tk.END)
            entry_preco.delete(0, tk.END)
            entry_cat.delete(0, tk.END)
            id_item_selecionado[0] = ""
