    if not expediente_ativo or not pedido_atual: 
        messagebox.showwarning("Aviso", "Não há itens para imprimir ou expediente fechado.")
        return
    
    FONTE_NORMAL = "\x1b\x21\x00"
    FONTE_GRANDE = "\x1b\x21\x30"  
    NEGRITO      = "\x1b\x21\x08"
    CENTRALIZAR  = "\x1b\x61\x01"  
    ESQUERDA     = "\x1b\x61\x00"  
    
    texto = f"{CENTRALIZAR}{NEGRITO}==== VIA DE PRODUCAO / COZINHA ===={FONTE_NORMAL}\n\n"
    texto += f"{CENTRALIZAR}{FONTE_GRANDE}DESTINO: {combo_tipo.get().upper()}{FONTE_NORMAL}\n\n"
    texto += f"{ESQUERDA}Hora: {datetime.now().strftime('%H:%M:%S')}\n"
    texto += "-----------------------------------\n\n"
    
    for i in pedido_atual:
        texto += f"{FONTE_GRANDE}* {i['nome']}{FONTE_NORMAL}\n"  
        if i["obs"]: 
            texto += f"   {NEGRITO}Obs: {i['obs']}{FONTE_NORMAL}\n" 
        texto += "-----------------------------------\n"
        
    texto += "\n\n\n\n\n"
    texto += "\n\n\n\n\n"
    
    
    
    nome_impressora = "EPSON TM-T20X Receipt"
    try:
        p = win32print.OpenPrinter(nome_impressora)
        try:
            job = win32print.StartDocPrinter(p, 1, ("Cupom Cozinha", None, "RAW"))
            win32print.StartPagePrinter(p)
            win32print.WritePrinter(p, texto.encode('cp850'))
            win32print.EndPagePrinter(p)
            win32print.EndDocPrinter(p)
        finally:
            win32print.ClosePrinter(p)
            
    except Exception as e:
        messagebox.showerror("Erro de Impressão", f"Falha na impressora: {e}")

