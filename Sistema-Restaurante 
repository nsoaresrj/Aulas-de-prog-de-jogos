def registrar_pedido(total, status_entrega, status_fin, forma_pagamento):
    cliente = entry_cliente.get().strip() or "Consumidor Final"
    tipo_atendimento = combo_tipo.get()
    
    cursor.execute("""
        INSERT INTO pedidos (cliente, tipo, itens, total, pagamento, status, status_pagamento, expediente)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        cliente,
        tipo_atendimento,
        json.dumps(pedido_atual, ensure_ascii=False),
        total,
        forma_pagamento,
        status_entrega,
        status_fin,
        expediente_ativo  
    ))
    conn.commit()
    id_pedido = cursor.lastrowid
    salvar_arquivo_pedido_txt(id_pedido, cliente, tipo_atendimento, total)

def salvar_arquivo_pedido_txt(id_pedido, cliente, tipo, total):
    nome_arquivo = f"pedido_{id_pedido}_{cliente.replace(' ', '_')}.txt"
    caminho_completo = os.path.join(pasta_pedidos_atual, nome_arquivo)
    
    texto = f"=== COMPROVANTE DE PEDIDO ENVIADO ===\n"
    texto += f"Código Interno: {id_pedido}\n"
    texto += f"Movimento Ref: {expediente_ativo}\n"
    texto += f"Atendente/Cliente: {cliente}\n"
    texto += f"Destino Faturamento: {tipo}\n"
    texto += f"--------------------------------------\n"
    texto += f"ITENS PROCESSADOS:\n"
    for i in pedido_atual:
        obs = f" ({i['obs']})" if i['obs'] else ""
        texto += f" - {i['nome']}{obs:<30} : R$ {i['preco']:.2f}\n"
    texto += f"--------------------------------------\n"
    texto += f"VALOR TOTAL: R$ {total:.2f}\n"
    
    with open(caminho_completo, "w", encoding="utf-8") as f:
        f.write(texto)

