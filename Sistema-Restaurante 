            cursor.execute("DELETE FROM cardapio WHERE id=?", (id_item,))
            conn.commit()
            carregar()
            atualizar_cardapio()
            
            entry_nome.delete(0, tk.END)
            entry_preco.delete(0, tk.END)
            entry_cat.delete(0, tk.END)
