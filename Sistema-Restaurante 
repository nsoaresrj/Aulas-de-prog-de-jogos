def fechar_comanda():
    if not expediente_ativo: return
    mesa = combo_tipo.get()
    
    cursor.execute("SELECT itens, total FROM pedidos WHERE tipo=? AND status_pagamento='ABERTO' AND expediente=?", (mesa, expediente_ativo))
    pedidos_mesa = cursor.fetchall()
    
    if not pedidos_mesa:
        messagebox.showinfo("Limpo", f"Não há contas abertas para a {mesa}.")
        return

    total_acumulado = 0.0
    lista_itens_comanda = []
    
    for itens_json, total_pedido in pedidos_mesa:
        total_acumulado += total_pedido
        try:
            itens_lista = json.loads(itens_json)
            for item in itens_lista:
                lista_itens_comanda.append((item['nome'], item.get('obs', ''), item['preco']))
        except:
            pass
    
    # Texto formatado de pré-visualização limpa para a tela do computador
    texto_preview = f"=== LOS TEMPERADOS - CONFERENCIA ===\n"
    texto_preview += f"Conta: {mesa}\n"
    texto_preview += f"Data/Hora: {datetime.now().strftime('%d/%m/%Y %H:%M:%S')}\n"
    texto_preview += "--------------------------------------\n"
    texto_preview += "ITENS CONSUMIDOS:\n"
    for nome, obs, preco in lista_itens_comanda:
        obs_str = f" ({obs})" if obs else ""
        texto_preview += f" * {nome}{obs_str:<22} R$ {preco:.2f}\n"
    texto_preview += "--------------------------------------\n"
    texto_preview += f"TOTAL ACUMULADO: R$ {total_acumulado:.2f}\n"

    popup_mesa = tk.Toplevel()
    popup_mesa.title(f"Fechamento de Conta - {mesa}")
    popup_mesa.geometry("460x650") 
    popup_mesa.configure(bg="#ffffff")
    popup_mesa.grab_set()

    tk.Label(popup_mesa, text=f"DETALHES DE CONSUMO ACUMULADO - {mesa}", font=("Arial", 10, "bold"), bg="#fff3cd", fg="#856404", pady=10).pack(fill="x")
    
    txt_area = tk.Text(popup_mesa, font=("Courier New", 10), height=10, bd=1, relief="solid")
    txt_area.pack(fill="both", expand=True, padx=15, pady=5)
    txt_area.insert(tk.END, texto_preview.strip())
    txt_area.config(state="disabled")

    tk.Label(popup_mesa, text=f"TOTAL ACUMULADO: R$ {total_acumulado:.2f}", font=("Arial", 14, "bold"), bg="#ffffff", fg="#198754").pack(pady=5)

    frame_p = tk.Frame(popup_mesa, bg="#ffffff", padx=20, pady=5)
    frame_p.pack(fill="x")

    tk.Label(frame_p, text="Forma de Pagamento:", font=("Arial", 9, "bold"), bg="#ffffff").pack(anchor="w")
    c_pag = ttk.Combobox(frame_p, values=["Pix", "Cartão de Crédito", "Cartão de Débito", "Dinheiro"], state="readonly", font=("Arial", 10))
    c_pag.pack(fill="x", pady=5)
    c_pag.current(0)

    frame_dinheiro_mesa = tk.Frame(frame_p, bg="#ffffff")
    
    lbl_rec_mesa = tk.Label(frame_dinheiro_mesa, text="Valor Recebido (R$):", font=("Arial", 9, "bold"), bg="#ffffff")
    lbl_rec_mesa.pack(anchor="w", pady=2)
    
    ent_recebido_mesa = ttk.Entry(frame_dinheiro_mesa, font=("Arial", 10))
    ent_recebido_mesa.pack(fill="x", pady=2)
    
    lbl_troco_mesa = tk.Label(frame_dinheiro_mesa, text="Troco: R$ 0.00", font=("Arial", 12, "bold"), bg="#ffffff", fg="#0d6efd", pady=5)
    lbl_troco_mesa.pack(anchor="w")

    def calcular_troco_mesa(event=None):
        try:
            recebido_str = ent_recebido_mesa.get().strip().replace(",", ".")
            if not recebido_str:
                lbl_troco_mesa.config(text="Troco: R$ 0.00", fg="#0d6efd")
                btn_concluir.config(state="normal")
                return
            
            val_recebido = float(recebido_str)
            if val_recebido < total_acumulado:
                lbl_troco_mesa.config(text="Valor Insuficiente!", fg="#dc3545")
                btn_concluir.config(state="disabled")
            else:
                lbl_troco_mesa.config(text=f"Troco: R$ {val_recebido - total_acumulado:.2f}", fg="#198754")
                btn_concluir.config(state="normal")
        except ValueError:
            lbl_troco_mesa.config(text="Valor Inválido!", fg="#dc3545")
            btn_concluir.config(state="disabled")

    ent_recebido_mesa.bind("<KeyRelease>", calcular_troco_mesa)

    def monitorar_combobox_mesa(event):
        if c_pag.get() == "Dinheiro":
            frame_dinheiro_mesa.pack(fill="x", pady=5)
            calcular_troco_mesa()
        else:
            frame_dinheiro_mesa.pack_forget()
            btn_concluir.config(state="normal")

    c_pag.bind("<<ComboboxSelected>>", monitorar_combobox_mesa)

    def executing_impressao_cliente():
        # COMANDOS ESC/POS INTERNOS DA IMPRESSORA TÉRMICA
        FONTE_NORMAL = "\x1b\x21\x00"
        FONTE_GRANDE = "\x1b\x21\x30"  
        NEGRITO      = "\x1b\x21\x08"
        CENTRALIZAR  = "\x1b\x61\x01"  
        ESQUERDA     = "\x1b\x61\x00"
        
        largura_max_linha = 42 # Padrão seguro para bobinas térmicas de 80mm
        
        texto_termica = f"{CENTRALIZAR}{NEGRITO}=== LOS TEMPERADOS ===\nCONFERENCIA DE CONTA{FONTE_NORMAL}\n\n"
        texto_termica += f"{ESQUERDA}{NEGRITO}Conta: {mesa}{FONTE_NORMAL}\n"
        texto_termica += f"Data/Hora: {datetime.now().strftime('%d/%m/%Y %H:%M:%S')}\n"
        texto_termica += "------------------------------------------\n"
        texto_termica += f"{NEGRITO}ITENS CONSUMIDOS:{FONTE_NORMAL}\n"
        
        for nome, obs, preco in lista_itens_comanda:
            nome_exibir = nome
            if obs:
                nome_exibir += f" ({obs})"
            
            preco_str = f"R$ {preco:.2f}"
            
            # PROTEÇÃO CONTRA CORTE DE VALOR: se o nome+preço passar do limite, o preço vai para a linha seguinte alinhado à direita
            if len(nome_exibir) + len(preco_str) + 3 <= largura_max_linha:
                espacos = largura_max_linha - 3 - len(nome_exibir) - len(preco_str)
                texto_termica += f" * {nome_exibir}{' ' * espacos}{preco_str}\n"
            else:
                texto_termica += f" * {nome_exibir}\n"
                texto_termica += f"{' ' * (largura_max_linha - len(preco_str))}{preco_str}\n"
        
        texto_termica += "------------------------------------------\n"
        # TOTAL GRANDE E CENTRALIZADO NO CUPOM
        texto_termica += f"{CENTRALIZAR}{FONTE_GRANDE}TOTAL: R$ {total_acumulado:.2f}{FONTE_NORMAL}\n"
        texto_termica += "\n\n\n\n\n"
        texto_termica += "\n\n\n\n\n"
        
        nome_impressora = "EPSON TM-T20X Receipt"
        try:
            p = win32print.OpenPrinter(nome_impressora)
            try:
                job = win32print.StartDocPrinter(p, 1, ("Conta Cliente", None, "RAW"))
                win32print.StartPagePrinter(p)
                win32print.WritePrinter(p, texto_termica.encode('cp850'))
                win32print.EndPagePrinter(p)
                win32print.EndDocPrinter(p)
            finally:
                win32print.ClosePrinter(p)
        except Exception as e:
            messagebox.showerror("Erro de Impressão", f"Falha ao imprimir cupom: {e}")

    def concluir_fechamento_mesa():
        metodo = c_pag.get()
        if metodo == "Dinheiro":
            try:
                recebido_str = ent_recebido_mesa.get().strip().replace(",", ".")
                if recebido_str:
                    recebido = float(recebido_str)
                    if recebido < total_acumulado: return
            except:
                messagebox.showerror("Erro", "Insira o valor recebido corretamente.")
                return

        executing_impressao_cliente()
        cursor.execute("UPDATE pedidos SET status_pagamento='PAGO', pagamento=? WHERE tipo=? AND status_pagamento='ABERTO' AND expediente=?", (metodo, mesa, expediente_ativo))
        conn.commit()
        carregar_pedidos()
        popup_mesa.destroy()
        messagebox.showinfo("Sucesso", f"Conta da {mesa} encerrada e registrada como PAGA!")

    tk.Button(popup_mesa, text="🖨️ Imprimir Pré-Conta (Para levar à Mesa)", command=executing_impressao_cliente, bg="#6c757d", fg="white", font=("Arial", 10, "bold"), height=1, bd=0).pack(fill="x", padx=20, pady=3)
    
    btn_concluir = tk.Button(popup_mesa, text="✅ Receber e Imprimir Fechamento Completo", command=concluir_fechamento_mesa, bg="#198754", fg="white", font=("Arial", 10, "bold"), height=2, bd=0)
    btn_concluir.pack(fill="x", padx=20, pady=5)

def carregar_pedidos():
    tabela.delete(*tabela.get_children())
    if expediente_ativo:
        cursor.execute("SELECT id, cliente, tipo, total, status, status_pagamento FROM pedidos WHERE expediente=? ORDER BY id DESC", (expediente_ativo,))
    else:
        cursor.execute("SELECT id, cliente, tipo, total, status, status_pagamento FROM pedidos ORDER BY id DESC")
    for p in cursor.fetchall():
        tabela.insert("", tk.END, iid=p[0], values=p[1:])

def alterar_status():
    sel = tabela.selection()
    if not sel: return
    cursor.execute("UPDATE pedidos SET status=? WHERE id=?", (combo_status.get(), sel[0]))
    conn.commit()
    carregar_pedidos()

