def abrir_popup_pagamento():
    if not expediente_ativo:
        messagebox.showerror("Erro de Turno", "É obrigatório INICIAR O EXPEDIENTE antes de lançar vendas!")
        return
    if not pedido_atual:
        messagebox.showwarning("Carrinho Vazio", "Adicione pelo menos um item ao carrinho antes de fechar.")
        return

    total_venda = sum(i["preco"] for i in pedido_atual)
    
    popup = tk.Toplevel()
    popup.title("Finalização de Venda / Caixa")
    popup.geometry("400x450")
    popup.configure(bg="#ffffff")
    popup.grab_set()
    popup.resizable(False, False)

    lbl_v = tk.Label(popup, text=f"TOTAL A PAGAR\nR$ {total_venda:.2f}", font=("Arial", 18, "bold"), bg="#f8f9fa", fg="#198754", pady=15)
    lbl_v.pack(fill="x")

    frame_corpo = tk.Frame(popup, bg="#ffffff", padx=20, pady=10)
    frame_corpo.pack(fill="both", expand=True)

    tk.Label(frame_corpo, text="Escolha o Método de Pagamento:", font=("Arial", 10, "bold"), bg="#ffffff", fg="#212529").pack(anchor="w", pady=5)
    
    combo_pag = ttk.Combobox(frame_corpo, values=["Pix", "Cartão de Crédito", "Cartão de Débito", "Dinheiro"], state="readonly", font=("Arial", 11))
    combo_pag.pack(fill="x", pady=5)
    combo_pag.current(0)

    frame_dinheiro = tk.Frame(frame_corpo, bg="#ffffff")
    
    lbl_rec = tk.Label(frame_dinheiro, text="Valor Recebido (R$):", font=("Arial", 9, "bold"), bg="#ffffff")
    lbl_rec.pack(anchor="w", pady=2)
    
    ent_recebido = ttk.Entry(frame_dinheiro, font=("Arial", 11))
    ent_recebido.pack(fill="x", pady=2)
    
    lbl_troco = tk.Label(frame_dinheiro, text="Troco: R$ 0.00", font=("Arial", 12, "bold"), bg="#ffffff", fg="#0d6efd", pady=5)
    lbl_troco.pack(anchor="w")

    def calcular_troco_dinamico(event=None):
        try:
            recebido_str = ent_recebido.get().strip().replace(",", ".")
            if not recebido_str:
                lbl_troco.config(text="Troco: R$ 0.00", fg="#0d6efd")
                btn_confirmar.config(state="normal")
                return
            
            val_recebido = float(recebido_str)
            if val_recebido < total_venda:
                lbl_troco.config(text="Valor Insuficiente!", fg="#dc3545")
                btn_confirmar.config(state="disabled")
            else:
                lbl_troco.config(text=f"Troco: R$ {val_recebido - total_venda:.2f}", fg="#198754")
                btn_confirmar.config(state="normal")
        except ValueError:
            lbl_troco.config(text="Valor Inválido!", fg="#dc3545")
            btn_confirmar.config(state="disabled")

    ent_recebido.bind("<KeyRelease>", calcular_troco_dinamico)

    def monitorar_combobox(event):
        if combo_pag.get() == "Dinheiro":
            frame_dinheiro.pack(fill="x", pady=10)
            calcular_troco_dinamico()
        else:
            frame_dinheiro.pack_forget()
            btn_confirmar.config(state="normal")

    combo_pag.bind("<<ComboboxSelected>>", monitorar_combobox)

    def acao_pagar_agora():
        metodo = combo_pag.get()
        if metodo == "Dinheiro":
            try:
                recebido = float(ent_recebido.get().strip().replace(",", "."))
                if recebido < total_venda: return
            except:
                messagebox.showerror("Erro", "Insira o valor recebido corretamente.")
                return
        
            registrar_pedido(total_venda, "Preparando", "PAGO", metodo)
            limpar_pedido_sucesso()
            popup.destroy()
        else:
            registrar_pedido(total_venda, "Preparando", "PAGO", metodo)
            limpar_pedido_sucesso()
            popup.destroy()

    def acao_lancar_mesa():
        if "Mesa" not in combo_tipo.get():
            messagebox.showwarning("Tipo Inválido", "Apenas atendimentos direcionados a 'Mesa' podem ficar em aberto!")
            return
        
        registrar_pedido(total_venda, "Preparando", "ABERTO", "Pendente")
        limpar_pedido_sucesso()
        popup.destroy()

    btn_confirmar = tk.Button(frame_corpo, text="🟢 CONFIRMAR E PAGAR AGORA", command=acao_pagar_agora, bg="#198754", fg="white", font=("Arial", 10, "bold"), height=2, bd=0)
    btn_confirmar.pack(fill="x", pady=10, side="top")

    btn_mesa = tk.Button(frame_corpo, text="⏳ LANÇAR NA CONTA DA MESA", command=acao_lancar_mesa, bg="#ffc107", fg="#212529", font=("Arial", 10, "bold"), height=2, bd=0)
    btn_mesa.pack(fill="x", pady=2, side="top")

def limpar_pedido_sucesso():
    pedido_atual.clear()
    entry_cliente.delete(0, tk.END)
    atualizar_pedido()
    carregar_pedidos()

