    tk.Label(frame_inputs, text="Nome do Produto:", bg="#f8f9fa", font=("Arial", 9, "bold")).pack(anchor="w")
    entry_nome = ttk.Entry(frame_inputs)
    entry_nome.pack(fill="x", pady=2)

    tk.Label(frame_inputs, text="Preço de Venda (R$):", bg="#f8f9fa", font=("Arial", 9, "bold")).pack(anchor="w")
    entry_preco = ttk.Entry(frame_inputs)
    entry_preco.pack(fill="x", pady=2)

    tk.Label(frame_inputs, text="Categoria do Item:", bg="#f8f9fa", font=("Arial", 9, "bold")).pack(anchor="w")
